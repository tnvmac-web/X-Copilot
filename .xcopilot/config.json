{
  "preferred_tools": [],
  "code_style": {
    "indent": 4,
    "type_hints": true
  },
  "conventions": {
    "money_as_cents": true
  },
  "anti_patterns": [],
  "models": {
    "default": "anthropic",
    "fallback_chain": [
      "ollama",
      "lmstudio",
      "openrouter"
    ],
    "openai": {
      "api_key": "${OPENAI_API_KEY}"
    },
    "anthropic": {
      "api_key": "${ANTHROPIC_API_KEY}"
    },
    "ollama": {
      "base_url": "http://localhost:11434"
    },
    "lmstudio": {
      "base_url": "http://localhost:1234/v1"
    },
    "openrouter": {
      "api_key": "${OPENROUTER_API_KEY}"
    },
    "nvidia": {
      "api_key": "${NVIDIA_API_KEY}",
      "base_url": "https://integrate.api.nvidia.com/v1"
    }
  },
  "updater": {
    "enabled": true,
    "channel": "stable",
    "auto_update": true
  },
  "server": {
    "host": "0.0.0.0",
    "port": 8000,
    "auth": {
      "enabled": true,
      "username": "admin",
      "password": "${XCOPILOT_ADMIN_PASSWORD}"
    }
  },
  "mcp": {
    "servers": {}
  }
}